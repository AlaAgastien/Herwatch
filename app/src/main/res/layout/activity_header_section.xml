<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink"
    tools:context=".HeaderSection">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginVertical="100dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="50dp"
            >

            <androidx.cardview.widget.CardView
                android:id="@+id/UsermenuPsy"
                android:layout_width="180dp"
                android:layout_height="150dp"
                android:layout_marginLeft="10dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/doctor" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="PSYCHOLOGIST"
                    android:textStyle="bold"
                    android:layout_marginTop="120dp"
                    android:textColor="@color/pink"/>

            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/UsermenuBookings"
                android:layout_width="180dp"
                android:layout_height="150dp"
                android:layout_marginRight="20dp"
                app:cardCornerRadius="16dp"
                android:layout_marginLeft="10dp">

                <ImageView
                    android:layout_width="119dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/booking" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="BOOKING HISTORY"
                    android:textStyle="bold"
                    android:layout_marginTop="120dp"
                    android:textColor="@color/pink"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
>
                <androidx.cardview.widget.CardView
                    android:id="@+id/Usermenutrustedpeop"
                    android:layout_width="180dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="10dp"
                    app:cardCornerRadius="16dp">

                    <ImageView

                        android:layout_width="133dp"
                        android:layout_height="93dp"
                        android:layout_gravity="center"
                        android:src="@drawable/friends"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="FRIENDS &amp; FAMILY"
                        android:textStyle="bold"
                        android:textColor="@color/pink"
                        android:layout_marginTop="120dp"
                        android:gravity="center"/>


                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/UsermenuLaw"
                    android:layout_width="180dp"
                    android:layout_height="150dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp">

                    <ImageView
                        android:layout_width="123dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"
                        android:src="@drawable/law"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="120dp"
                        android:gravity="center"
                        android:text="LEGAL LAWS"
                        android:textColor="@color/pink"
                        android:textStyle="bold"/>

                </androidx.cardview.widget.CardView>


        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/UsermenuSelfdef"
                android:layout_width="180dp"
                android:layout_height="150dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:layout_width="129dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center"
                    android:src="@drawable/defence"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="SELF DEFENCE"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="120dp"
                    android:textColor="@color/pink"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>