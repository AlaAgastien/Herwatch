<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Psychologist">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:src="@drawable/signupregister"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp" />

            <!-- Name Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp">
                <EditText
                    android:id="@+id/RegNamePsy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name"
                    android:textSize="20dp"
                    android:drawableEnd="@drawable/baseline_person_outline_24"
                    android:drawableTint="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp">
                <EditText
                    android:id="@+id/RegEmailPsy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:textSize="20dp"
                    android:drawableEnd="@drawable/baseline_email_24"
                    android:drawableTint="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Number Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp">
                <EditText
                    android:id="@+id/RegphonePsy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone number"
                    android:textSize="20dp"
                    android:drawableEnd="@drawable/baseline_call_24"
                    android:drawableTint="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Work Place Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp">
                <EditText
                    android:id="@+id/Regworkpsy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Work Place"
                    android:textSize="20dp"
                    android:drawableEnd="@drawable/workplace1"
                    android:drawableTint="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Specialization Spinner -->
            <Spinner
                android:id="@+id/Regspecpsy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="20dp" />

            <!-- Experience Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp">
                <EditText
                    android:id="@+id/Regexppsy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Experience"
                    android:textSize="20dp"
                    android:drawableEnd="@drawable/experienceremoved"
                    android:drawableTint="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/white">
                <EditText
                    android:id="@+id/RegpassPsy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:textSize="20dp"
                    android:drawableTint="@color/pink" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sign Up Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/RegSignPsy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:backgroundTint="@color/pink"
                android:textColor="@color/white"
                android:text="Sign up" />

            <!-- Already Registered Text -->
            <TextView
                android:id="@+id/tologinPsy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I'm already registered?"
                android:textColor="@color/pink"
                android:gravity="center"
                android:textStyle="normal|bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="29dp" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
