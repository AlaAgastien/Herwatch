<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Psychologistfullactivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="70dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor Details"
                android:textSize="35dp"
                android:textStyle="bold"
                android:textColor="@color/pink"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FDE4E7"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/details_doc_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doctor Name"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/pink"/>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FDE4E7"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/details_doc_mail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doctor Email"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/pink"/>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FDE4E7"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/details_doc_cont"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doctor Contact"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/pink"/>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FDE4E7"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Work Place:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/details_doc_work"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Work Place"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/pink"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FDE4E7"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specilization:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/details_doc_spect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specilization in"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/pink"/>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FDE4E7"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experience:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/details_doc_exp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Year of experience"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/pink"/>

            </LinearLayout>
            <Button
                android:id="@+id/details_doc_butn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_gravity="center"
                android:text="BOOK NOW" />

        </LinearLayout>
    </RelativeLayout>

</ScrollView>