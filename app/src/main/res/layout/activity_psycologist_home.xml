<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PsycologistHome"
    android:background="@color/white">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/pink"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Psychologist Home"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/Psyhomeid"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/login"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:gravity="center">

        <!-- Patient Records Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/psyhomepatrecord"
            android:layout_width="300dp"
            android:layout_height="120dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="53dp"
                    android:layout_height="50dp"
                    android:src="@drawable/img_3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Records"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Approved Patient List Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/psyhomeapproved_patrecord"
            android:layout_width="300dp"
            android:layout_height="120dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/img" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approved Patients"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Payments Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/psyhomepayments"
            android:layout_width="300dp"
            android:layout_height="120dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/img" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payments"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</RelativeLayout>
