<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.Profilefragment"
    >

    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="660dp"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        >
        <ImageView
            android:layout_width="130dp"
            android:layout_height="120dp"
            android:layout_marginTop="30dp"
            android:layout_marginHorizontal="120dp"
            android:src="@drawable/profile">
        </ImageView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="P R O F I L E"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/pink"
            android:gravity="center"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="0dp"></TextView>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">
            <EditText
                android:id="@+id/proname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" Name"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:drawableRight="@drawable/baseline_person_outline_24"
                android:drawableTint="@color/pink"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">
            <EditText
                android:id="@+id/proemail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" Email"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:drawableRight="@drawable/baseline_email_24"
                android:drawableTint="@color/pink"
                />

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">
            <EditText
                android:id="@+id/prophone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone number"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:drawableRight="@drawable/baseline_call_24"
                android:drawableTint="@color/pink"
                />

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">
            <EditText
                android:id="@+id/proguard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Guardian number"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:drawableRight="@drawable/baseline_contact_phone_24"
                android:drawableTint="@color/pink"
                />

        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/pink"
            >
            <EditText
                android:id="@+id/propass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:textColor="@color/black"
                android:textColorHint="@color/black"

                />

        </com.google.android.material.textfield.TextInputLayout>



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/proupdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="update"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/pink"
            />
        <TextView
            android:id="@+id/prohome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textSize="13dp"
            android:textColor="@color/pink"
            android:gravity="center"
            android:layout_marginTop="10dp"
            />

    </LinearLayout>

</RelativeLayout>